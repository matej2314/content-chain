          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/bootstrap-status"
          }
        },
        {
          "name": "POST bootstrap-admin weak password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const available = pm.collectionVariables.get('bootstrapAvailable') === 'true';",
                  "const body = pm.response.json();",
                  "if (available) {",
                  "  pm.test('status 400 when bootstrap is open', function () {",
                  "    pm.response.to.have.status(400);",
                  "  });",
                  "  pm.test('VALIDATION_FAILED password policy', function () {",
                  "    pm.expect(body.code).to.eql('VALIDATION_FAILED');",
                  "    pm.expect(body.message).to.be.a('string').that.is.not.empty;",
                  "  });",
                  "} else {",
                  "  pm.test('status 409 when admin already exists', function () {",
                  "    pm.response.to.have.status(409);",
                  "  });",
                  "  pm.test('CONFLICT before password policy', function () {",
                  "    pm.expect(body.code).to.eql('CONFLICT');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"short\"\n}\n"
            },
            "url": "{{baseUrl}}/auth/bootstrap-admin",
            "description": "Polityka: min. 12 znaków, cyfra, wielka litera, znak specjalny. Use-case najpierw sprawdza, czy admin już istnieje."
          }
        },
        {
          "name": "POST bootstrap-admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const available = pm.collectionVariables.get('bootstrapAvailable') === 'true';",
                  "const body = pm.response.json();",
                  "",
                  "function setCookieValues() {",
                  "  return pm.response.headers.all()",
                  "    .filter(function (h) { return h.key.toLowerCase() === 'set-cookie'; })",
                  "    .map(function (h) { return h.value; })",
                  "    .join('\\n');",
                  "}",
                  "",
                  "if (available) {",
                  "  pm.test('status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "  });",
                  "  pm.test('returns user without tokens', function () {",
                  "    pm.expect(body).to.have.property('user');",
                  "    pm.expect(body.user).to.include.keys('id', 'email', 'role');",
                  "    pm.expect(body.user.id).to.match(/^usr_/i);",
                  "    pm.expect(body.user.email).to.eql(pm.collectionVariables.get('adminEmail'));",
                  "    pm.expect(body.user.role).to.eql('admin');",
                  "    pm.expect(body).to.not.have.property('accessToken');",
                  "    pm.expect(body).to.not.have.property('refreshToken');",
                  "    pm.expect(body.user).to.not.have.property('passwordHash');",
                  "  });",
                  "  pm.test('sets cc_access and cc_refresh cookies', function () {",
                  "    const cookies = setCookieValues();",
                  "    pm.expect(cookies).to.include('cc_access=');",
                  "    pm.expect(cookies).to.include('cc_refresh=');",
                  "  });",
                  "} else {",
                  "  pm.test('status 409 when admin already exists', function () {",
                  "    pm.response.to.have.status(409);",
                  "  });",
                  "  pm.test('CONFLICT', function () {",
                  "    pm.expect(body.code).to.eql('CONFLICT');",
                  "    pm.expect(body.message).to.eql('Bootstrap admin already exists');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}\n"
            },
            "url": "{{baseUrl}}/auth/bootstrap-admin",
            "description": "201 + cookies gdy baza pusta. 409 gdy admin już jest. Body JSON bez tokenów."
          }
        },
        {
          "name": "POST bootstrap-admin again (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('CONFLICT', function () {",
                  "  pm.expect(body.code).to.eql('CONFLICT');",
                  "  pm.expect(body.message).to.eql('Bootstrap admin already exists');",
                  "  pm.expect(body.requestId).to.be.a('string').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}\n"
            },
            "url": "{{baseUrl}}/auth/bootstrap-admin",
            "description": "Po udanym bootstrapie (albo gdy admin już był) zawsze 409."
          }
        },
        {
          "name": "GET bootstrap-status after",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('available === false', function () {",
                  "  pm.expect(body.available).to.eql(false);",
                  "});",
                  "pm.collectionVariables.set('bootstrapAvailable', 'false');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/bootstrap-status",
            "description": "Po istnieniu admina bootstrap nie jest już dostępny."
          }
        }
      ]
    },
    {
      "name": "Session",
      "description": "Happy path: login → me → refresh → me → logout → me/refresh 401. Wymaga istniejącego admina (`adminEmail` / `adminPassword`).",
      "item": [
        {
          "name": "POST login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('expiresIn + user without tokens', function () {",
                  "  pm.expect(body.expiresIn).to.be.a('string').that.is.not.empty;",
                  "  pm.expect(body.user).to.include.keys('id', 'email', 'role');",
                  "  pm.expect(body.user.id).to.match(/^usr_/i);",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('adminEmail'));",
                  "  pm.expect(body.user.role).to.eql('admin');",
                  "  pm.expect(body).to.not.have.property('accessToken');",
                  "  pm.expect(body).to.not.have.property('refreshToken');",
                  "});",
                  "",
                  "pm.test('sets cc_access and cc_refresh cookies', function () {",
                  "  const cookies = pm.response.headers.all()",
                  "    .filter(function (h) { return h.key.toLowerCase() === 'set-cookie'; })",
                  "    .map(function (h) { return h.value; })",
                  "    .join('\\n');",
                  "  pm.expect(cookies).to.include('cc_access=');",
                  "  pm.expect(cookies).to.include('cc_refresh=');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}\n"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "200 `{ expiresIn, user }`. Cookies httpOnly. Złe hasło → 401 Invalid credentials."
          }
        },
