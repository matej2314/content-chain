    {
      "name": "Unauthenticated",
      "description": "Negatywy bez sesji. Folder czyści cookie jar dla originu api, żeby 401 nie zależały od poprzedniego runu.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const origin = pm.collectionVariables.get('originUrl') || 'http://localhost:3001';",
              "try {",
              "  pm.cookies.jar().clear(origin, function () {});",
              "} catch (e) {",
              "  console.warn('cookie jar clear skipped', e);",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "GET bootstrap-status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('available is boolean', function () {",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body.available).to.be.a('boolean');",
                  "});",
                  "pm.test('no tokens in body', function () {",
                  "  pm.expect(body).to.not.have.property('accessToken');",
                  "  pm.expect(body).to.not.have.property('refreshToken');",
                  "});",
                  "",
                  "pm.collectionVariables.set('bootstrapAvailable', String(body.available));"
                ]
              }
