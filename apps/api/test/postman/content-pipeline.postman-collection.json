        {
          "name": "GET run until awaiting_hitl (B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const RUN_STATUSES = ['queued', 'running', 'interrupted', 'awaiting_hitl', 'completed', 'failed'];",
                  "const IN_FLIGHT = ['queued', 'running', 'interrupted'];",
                  "const MAX_POLLS = 120;",
                  "const POLL_MS = 3000;",
                  "",
                  "function wait(ms) {",
                  "  const until = Date.now() + ms;",
                  "  while (Date.now() < until) {",
                  "    /* delay between Collection Runner / Newman retries */",
                  "  }",
                  "}",
                  "",
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code !== 200) {",
                  "  return;",
                  "}",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('status is a run enum', function () {",
                  "  pm.expect(RUN_STATUSES).to.include(body.status);",
                  "});",
                  "",
                  "const polls = Number(pm.collectionVariables.get('pollCountHitl') || 0) + 1;",
                  "pm.collectionVariables.set('pollCountHitl', String(polls));",
                  "",
                  "if (body.status === 'failed') {",
                  "  pm.test('run did not fail before HITL', function () {",
                  "    pm.expect.fail('run failed: ' + pm.response.text());",
                  "  });",
                  "  return;",
                  "}",
                  "",
                  "if (body.status === 'completed') {",
                  "  pm.test('page_outline_then_copy pauses for HITL', function () {",
                  "    pm.expect.fail('completed before HITL');",
                  "  });",
                  "  return;",
                  "}",
                  "",
                  "if (body.status !== 'awaiting_hitl') {",
                  "  pm.test('status is still in-flight or awaiting_hitl', function () {",
                  "    pm.expect(IN_FLIGHT).to.include(body.status);",
                  "  });",
                  "  if (polls >= MAX_POLLS) {",
                  "    pm.test('awaiting_hitl within poll budget', function () {",
                  "      pm.expect.fail('timeout waiting for awaiting_hitl (last: ' + body.status + ')');",
                  "    });",
                  "    return;",
                  "  }",
                  "  wait(POLL_MS);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "",
                  "pm.test('outline id present', function () {",
                  "  pm.expect(body.result).to.be.an('object');",
                  "  const fromHitl = body.hitl && body.hitl.options && body.hitl.options[0] && body.hitl.options[0].id;",
                  "  const fromResult = body.result.pageOutline && body.result.pageOutline.id;",
                  "  const outlineId = fromHitl || fromResult;",
                  "  pm.expect(outlineId).to.be.a('string').that.is.not.empty;",
                  "  pm.collectionVariables.set('ideaId', outlineId);",
                  "});",
                  "pm.test('optional section role is a known enum when present', function () {",
                  "  const outline = body.result.pageOutline;",
                  "  if (!outline || !Array.isArray(outline.sections)) return;",
                  "  const roles = ['audience_world', 'pain', 'challenger', 'insight', 'proof', 'objection', 'cta', 'other'];",
                  "  outline.sections.forEach(function (section) {",
                  "    if (section.role != null) {",
                  "      pm.expect(roles).to.include(section.role);",
                  "    }",
                  "  });",
                  "});",
                  "pm.collectionVariables.set('pollCountHitl', '0');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/runs/{{runId}}"
