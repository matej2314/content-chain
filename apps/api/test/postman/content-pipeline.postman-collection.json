    {
      "name": "A. page_copy",
      "description": "Full-auto: `POST /runs` bez `platform`, z `contentKind: blog`, brief bez `ideaCount` → poll `GET /runs/:runId` aż `completed` → `result.pageDocument.body` → `GET .../logs`.",
      "item": [
        {
          "name": "POST runs (page_copy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const RUN_STATUSES = ['queued', 'running', 'interrupted', 'awaiting_hitl', 'completed', 'failed'];",
                  "pm.test('runId present', function () {",
                  "  pm.expect(body.runId).to.be.a('string').that.is.not.empty;",
                  "});",
                  "pm.test('status is a run enum', function () {",
                  "  pm.expect(RUN_STATUSES).to.include(body.status);",
                  "});",
                  "pm.collectionVariables.set('runId', body.runId);",
                  "pm.collectionVariables.set('pollCountA', '0');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskType\": \"page_copy\",\n  \"contentKind\": \"blog\",\n  \"language\": \"pl\",\n  \"brief\": { \"topic\": \"Audyt procesów\" }\n}\n"
            },
            "url": "{{baseUrl}}/runs"
          }
        },
        {
          "name": "GET run until completed (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const RUN_STATUSES = ['queued', 'running', 'interrupted', 'awaiting_hitl', 'completed', 'failed'];",
                  "const IN_FLIGHT = ['queued', 'running', 'interrupted'];",
                  "const MAX_POLLS = 120;",
                  "const POLL_MS = 3000;",
                  "",
                  "function wait(ms) {",
                  "  const until = Date.now() + ms;",
                  "  while (Date.now() < until) {",
                  "    /* delay between Collection Runner / Newman retries */",
                  "  }",
                  "}",
                  "",
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code !== 200) {",
                  "  return;",
                  "}",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('status is a run enum', function () {",
                  "  pm.expect(RUN_STATUSES).to.include(body.status);",
                  "});",
                  "",
                  "const polls = Number(pm.collectionVariables.get('pollCountA') || 0) + 1;",
                  "pm.collectionVariables.set('pollCountA', String(polls));",
                  "",
                  "if (body.status === 'failed') {",
                  "  pm.test('run did not fail', function () {",
                  "    pm.expect.fail('run failed: ' + pm.response.text());",
                  "  });",
                  "  return;",
                  "}",
                  "",
                  "if (body.status === 'awaiting_hitl') {",
                  "  pm.test('page_copy does not pause for HITL', function () {",
                  "    pm.expect.fail('unexpected awaiting_hitl on page_copy');",
                  "  });",
                  "  return;",
                  "}",
                  "",
                  "if (body.status !== 'completed') {",
                  "  pm.test('status is still in-flight or completed', function () {",
                  "    pm.expect(IN_FLIGHT).to.include(body.status);",
                  "  });",
                  "  if (polls >= MAX_POLLS) {",
                  "    pm.test('completed within poll budget', function () {",
                  "      pm.expect.fail('timeout waiting for completed (last: ' + body.status + ')');",
                  "    });",
                  "    return;",
                  "  }",
                  "  wait(POLL_MS);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "",
                  "pm.test('result.pageDocument.body is non-empty', function () {",
                  "  pm.expect(body.result).to.be.an('object');",
                  "  pm.expect(body.result.pageDocument).to.be.an('object');",
                  "  pm.expect(body.result.pageDocument.body).to.be.a('string').that.is.not.empty;",
                  "});",
                  "pm.test('contentKind blog and platform web', function () {",
                  "  pm.expect(body.contentKind).to.eql('blog');",
                  "  pm.expect(body.platform).to.eql('web');",
                  "});",
                  "pm.collectionVariables.set('pollCountA', '0');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/runs/{{runId}}"
          }
        },
        {
          "name": "GET run logs (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const raw = pm.response.text();",
                  "const body = pm.response.json();",
                  "pm.test('items is a non-empty array', function () {",
                  "  pm.expect(body.items).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('some hop has conversationId', function () {",
                  "  const hit = body.items.some(function (entry) {",
                  "    return typeof entry.conversationId === 'string' && entry.conversationId.length > 0;",
                  "  });",
                  "  pm.expect(hit).to.eql(true);",
                  "});",
                  "pm.test('some hop has requestId', function () {",
                  "  const hit = body.items.some(function (entry) {",
                  "    return typeof entry.requestId === 'string' && entry.requestId.length > 0;",
                  "  });",
                  "  pm.expect(hit).to.eql(true);",
                  "});",
                  "pm.test('no gateway secret in body', function () {",
                  "  pm.expect(raw).to.not.match(/X-Gateway-Key/i);",
                  "  pm.expect(raw).to.not.match(/GATEWAY_KEY/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/runs/{{runId}}/logs"
          }
        }
      ]
    },
