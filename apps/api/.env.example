# Copy to .env and adjust values. Do not commit .env.
PORT=3001
APP_PUBLIC_URL=http://localhost:3000
NODE_ENV=development
# V1 — PostgreSQL (compose hostname `postgres` albo managed).
DATABASE_URL="postgresql://cc:cc@localhost:5432/content_chain?schema=public"
POSTGRES_USER=cc
POSTGRES_PASSWORD=cc
POSTGRES_DB=content_chain
GATEWAY_BASE_URL=http://localhost:3100
GATEWAY_KEY="change-me-gateway-key"
GATEWAY_MODEL_ALIAS="chat-default"
MAX_CONCURRENT_RUNS=3
MAX_USER_IN_FLIGHT_RUNS=3
SSE_HEARTBEAT_MS=25000
RUN_SSE_SUBJECT_TTL_MS=600000

JWT_SECRET="change-me-jwt-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="1d"
INVITE_TTL="7d"
REVIEW_TTL="2h"
REVIEW_SWEEP_INTERVAL="5m"
MAIL_FROM="noreply@localhost"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER="mail"
SMTP_PASS="change-me-smtp-pass"
CORS_ORIGIN='http://localhost:3000'

ACTIVATION_TTL="7d"
EMAIL_CHANGE_TTL="1d"

DEMO_MODE=false
GUEST_GLOBAL_CAP_PER_DAY=30
GUEST_RATING_CAP_PER_DAY=10
# Required when DEMO_MODE=true.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# Optional Redis AUTH password.
# REDIS_PASSWORD=
# REDIS_PASSWORD=your-redis-password