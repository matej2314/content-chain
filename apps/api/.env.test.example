# Skopiuj do .env.test i dostosuj wartości lokalne.
# Plik .env.test jest w .gitignore — nie commituj sekretów.
# Compose e2e mapuje 127.0.0.1:5433 → 5432 w kontenerze.

NODE_ENV=test
PORT=3001

POSTGRES_USER=e2e
POSTGRES_PASSWORD=replace-me-e2e-only
POSTGRES_DB=content_chain_test
DATABASE_URL="postgresql://e2e:replace-me-e2e-only@127.0.0.1:5433/content_chain_test?schema=public"

GATEWAY_BASE_URL=http://127.0.0.1:3100
GATEWAY_KEY=test-gateway-key
GATEWAY_MODEL_ALIAS=chat-default

JWT_SECRET=test-jwt-secret-not-for-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000
MAX_CONCURRENT_RUNS=3
MAX_USER_IN_FLIGHT_RUNS=3
