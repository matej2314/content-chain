# Copy to .env for local DX. Production Compose uses root .env (shared keys).
# Worker does not need CORS / SMTP / JWT — see validateWorkerEnv.
NODE_ENV=development
# Same Postgres as api (compose hostname `postgres` albo localhost).
DATABASE_URL="postgresql://user:password@localhost:5432/content_chain?schema=public"
GATEWAY_BASE_URL=http://localhost:3100
GATEWAY_KEY="change-me-gateway-key"
GATEWAY_MODEL_ALIAS="chat-default"
MAX_CONCURRENT_RUNS=3
REVIEW_TTL="2h"
REVIEW_SWEEP_INTERVAL="5m"
