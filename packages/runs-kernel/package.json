{
  "name": "@content-chain/runs-kernel",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "jest"
  },
  "dependencies": {
    "@content-chain/domain-kit": "workspace:*",
    "@content-chain/persistence": "workspace:*",
    "@content-chain/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@prisma/client": "^6",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!.*(?:uuid)/)"
    ],
    "moduleNameMapper": {
      "^@content-chain/domain-kit$": "<rootDir>/../../domain-kit/src/index.ts",
      "^@content-chain/domain-kit/(.*)$": "<rootDir>/../../domain-kit/src/$1",
      "^@content-chain/persistence$": "<rootDir>/../../persistence/src/index.ts",
      "^@content-chain/persistence/(.*)$": "<rootDir>/../../persistence/src/$1",
      "^@content-chain/shared$": "<rootDir>/../../shared/src/index.ts",
      "^@content-chain/shared/(.*)$": "<rootDir>/../../shared/src/$1"
    }
  }
}
